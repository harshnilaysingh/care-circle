# Runtime and public application URL
APP_URL=https://your-carecircle-domain.example
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes

# Neon Postgres pooled connection string. Keep this private.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Email verification and password reset (Resend)
RESEND_API_KEY=
EMAIL_FROM=CareCircle <hello@your-verified-domain.example>
SUPPORT_EMAIL=support@your-verified-domain.example

# PayPal REST API. Use sandbox until you have tested checkout and webhooks.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TRIAL_PLAN_ID=
PAYPAL_STANDARD_PLAN_ID=

# Base64 encoding of a cryptographically random 32-byte key; do not reuse BETTER_AUTH_SECRET.
DATA_ENCRYPTION_KEY=

# AI requests are server-side only. Set an available model for your account.
OPENAI_API_KEY=
OPENAI_MODEL=

